# See SETUP.md for how to get each of these. All three are free.

# Apify — free plan, $5/month credit. https://console.apify.com/settings/integrations
APIFY_TOKEN=

# Google AI Studio — free tier, no credit card. https://aistudio.google.com/apikey
# NOTE: this is the Vercel AI SDK's variable name, not Google's GEMINI_API_KEY.
GOOGLE_GENERATIVE_AI_API_KEY=

# Neon Postgres — free tier. Not needed in mock mode.
DATABASE_URL=

# mock   the Stage-1 simulator: no keys, no cost. The safe default.
# replay real LLM, but scrapes read from fixtures/ instead of calling Apify.
# live   the full pipeline.
PIPELINE_MODE=mock
# The client half of the same switch. These two must agree.
NEXT_PUBLIC_PIPELINE_MODE=mock

# Optional
# LLM_MODEL=gemini-3.6-flash
# CAPTURE_FIXTURES=1
